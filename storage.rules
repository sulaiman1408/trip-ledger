rules_version = '2';

// Paste this into: Firebase console → Storage → Rules.
//
// Expense attachments (receipt photos/PDFs) are uploaded under
// users/{uid}/... — only that user may read, upload, or delete their own
// files.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
